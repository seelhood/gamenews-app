#:import theme app_theme
#:import dp kivy.metrics.dp

<RegisterScreen>:
    AnchorLayout:
        anchor_x: 'center'
        anchor_y: 'center'
        canvas.before:
            Color:
                rgba: theme.BG_DARK
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            size: dp(350), dp(450)
            spacing: dp(15)
            padding: dp(20)

            Label:
                text: 'Регистрация'
                font_size: dp(30)
                bold: True
                size_hint_y: None
                height: dp(50)
                color: theme.ACCENT

            TextInput:
                id: username_input
                hint_text: 'Логин'
                multiline: False
                size_hint_y: None
                height: dp(50)
                background_color: theme.BG_PANEL
                foreground_color: theme.TEXT
                padding_x: dp(15)

            TextInput:
                id: email_input
                hint_text: 'Email'
                multiline: False
                size_hint_y: None
                height: dp(50)
                background_color: theme.BG_PANEL
                foreground_color: theme.TEXT
                padding_x: dp(15)

            TextInput:
                id: password_input
                hint_text: 'Пароль'
                password: True
                multiline: False
                size_hint_y: None
                height: dp(50)
                background_color: theme.BG_PANEL
                foreground_color: theme.TEXT
                padding_x: dp(15)

            Label:
                id: status_label
                text: ''
                size_hint_y: None
                height: dp(20)

            Button:
                text: 'Создать аккаунт'
                size_hint_y: None
                height: dp(50)
                background_normal: ''
                background_color: theme.SUCCESS
                on_release: root.do_register()

            Button:
                text: 'Назад'
                size_hint_y: None
                height: dp(40)
                background_normal: ''
                background_color: (0, 0, 0, 0)
                color: theme.TEXT_DIM
                on_release: root.go_to_login()